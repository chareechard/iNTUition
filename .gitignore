# Custom
.vscode/
venv
temp
tmp/
data.json
data.json.bak

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
# PyInstaller writes to the repo root. The canonical run (packaging/build-desktop.ps1)
# uses build/ and dist/, but one-off runs pass --workpath/--distpath with a suffix
# (build-notes/, dist-fixed/, ...), so ignore the whole root-anchored family.
.Python
/build*/
/dist*/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec
!packaging/*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.test-tmp/
.desktop-fix-test-*/
# pytest --basetemp=test droppings. The real suite lives in intuition/tests/,
# so this root-anchored entry cannot swallow it.
/test/

# Translations
*.mo
*.pot

# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/


# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/


# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/
# iNTUition local state
# Staging folder for downloaded course material, plus the Drive ledger and content
# cache that live inside it. Machine-specific and contains Drive file ids.
NTU/
.intuition/
drive_ledger.json
content_cache.json

# Personal documents and scratch images dropped in the repo root for one-off imports.
# The STARS registration PDF carries your name and enrolments; parse it, don't publish
# it. Anchored to the root so shipped assets under packaging/ and static/ stay tracked.
/Course(s) Registered*.pdf
/*.webp
/*.jfif
/*.jpg
/*.jpeg
/*.png

# A separate local-only context-bar utility may be present during development.
# Nothing in this package imports it; it is excluded from public release copies.
/claude-context-bar/

# Local dashboard launch traces
.dashboard-start.*.log

# Scratch workspace for ad-hoc debugging scripts/screenshots - pw-profile alone is a
# full Playwright/Chrome profile (cookies, autofill, web data), never something to commit.
.claude-scratch/

# Local clean-slate GitHub release staging copy
/github-clean-slate/


# Never commit account-derived exports or binary test captures.
intuition/tests/fixtures/
intuition/tests/full_data/
intuition/tests/download_dir_fixtures/
*.pkl
